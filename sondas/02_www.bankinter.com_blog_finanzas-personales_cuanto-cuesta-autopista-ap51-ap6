<script>
    var urlJsonAds = '/file_source/blog/Configuration/Json/ads-publicidad.json';
    var catAdv = '';

    function url_domain(data) {
        var a = document.createElement('a');
        a.href = data;
        return a.hostname.replace('www.', '');
    }


    function callDataAdv() {
        var request = new XMLHttpRequest();
        request.open('GET', urlJsonAds);
        request.responseType = 'json';
        request.onreadystatechange = function () {
            if (request.readyState === 4 && request.status == 200) {
                changeDataAdv(request.response.advertisements);
            }
        }
        request.send();
    }

    function changeDataAdv(advertisements) {
        var advArray = loadAds();
        /*ADV DEFAULT*/
        for (var i = 0; i < advertisements.length; i++) {
            if (advertisements[i].advdefault) {
                changeAds(advertisements[i])

            }
        }
        /*ADV ARRAY*/
        advArray.forEach(adv => {
            for (var i = 0; i < advertisements.length; i++) {
                if (adv == advertisements[i].advcategory) {
                    changeAds(advertisements[i])
                }
            }
        })
        /*PROMOVIEW*/
        isElementInScreen('.elemAdv01', [{'event': 'eventad', 'producto': catAdv}]);

    }

    function changeAds(adv) {
        document.querySelector('.elemAdv01').querySelector('a').setAttribute('href', adv.advlinkurl);
        document.querySelector('.elemAdv01').querySelector('img').setAttribute('src', adv.advimageurl);
        document.querySelector('.elemAdv01').querySelector('img').setAttribute('alt', adv.advimageAlt);
        document.querySelector('.elemAdv01').querySelector('a').setAttribute('onclick', 'generateAnalytics(\'' + adv.advlinkurl + '\',\'' + adv.advcategory + '\')');
        document.querySelector('.elemAdv01').classList.remove('d-none');
        catAdv = adv.advcategory;
    }

    function loadAds() {
        var advArray = [];
        if (document.querySelector('.advertising-news')) {
            var advNew = document.querySelector('.advertising-news').querySelectorAll('.advname');
            for (let i = 1; i < advNew.length; i++) {
                advArray.push(advNew[i].innerText);
            }
        }
        return advArray;
    }

    function generateAnalytics(url, category) {
        callAnalyticsEvent({
            'event': 'eventga',
            'event_name': 'navigation_click',
            'component_name': 'publicidad',
            'position': '[sin titulo][sin titulo]',
            'link_text': 'publicidad sobre ' + category,
            'element': 'publicidad sobre ' + category,
            'type': 'enlace',
            'link_domain': url_domain(url),
            'link_url': url,
        });
    }

    function isElementInScreen(whichElement, jsonArray) {
        var element = document.querySelector(whichElement);
        var screenBottom = window.innerHeight;
        var flag = false;
        if (element) {
            if (element.getBoundingClientRect().bottom <= screenBottom) {
                jsonArray.forEach(json => {
                    launchPromoViewAdvertisement(json);
                });
                flag = true;
            }
        }
        window.addEventListener('scroll', function () {
            if (element) {
                if (element.getBoundingClientRect().bottom <= screenBottom && flag === false) {
                    jsonArray.forEach(json => {
                        launchPromoViewAdvertisement(json);
                    });
                    flag = true;
                }
            }
        }, {
            passive: true
        });
    }

    function launchPromoViewAdvertisement(json) {
        if (json) callAnalyticsEvent(json);
    }

    document.addEventListener("DOMContentLoaded", function (event) {
        callDataAdv();
    });
</script>

