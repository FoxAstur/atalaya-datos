u00e3o atmosf\u00e9rica em Mb, Radia\u00e7\u00e3o Solar (watts/m2), Radia\u00e7\u00e3o Solar Watts/m2, Humidade Exterior (%), Humidade Exterior %, Velocidade Vento M\u00e9dia (km/h), Media da velocidade do Vento Km/h, Velocidade M\u00e1xima Vento (km/h), Velocidade M\u00e1xima do Vento Km/h, Dire\u00e7\u00e3o Vento, Dire\u00e7\u00e3o do vento \u00ba, UV, Index de UV, Radia\u00e7\u00e3o Solar (watts/m2), Radia\u00e7\u00e3o solar m\u00e1xima, M\u00e1xima UV\n\nOs dados podem ser acedidos atrav\u00e9s do site do projeto em [https://clima.aml.pt/page/publico](https://clima.aml.pt/page/publico) sendo poss\u00edvel exportar para os formatos txt ou xls, mas tamb\u00e9m podem ser acedidos atrav\u00e9s de API, atrav\u00e9s de credencia\u00e7\u00e3o previamente autorizada.\n\nA frequ\u00eancia de atualiza\u00e7\u00e3o real \u00e9 de 30 minutos.", "description_short": null, "extras": {}, "featured": false, "frequency": "hourly", "frequency_date": "2025-07-28T16:29:23+00:00", "harvest": null, "id": "688388e5662a9029c124d91c", "internal": {"created_at_internal": "2025-07-25T13:38:45.023000+00:00", "last_modified_internal": "2025-07-31T10:00:05.407000+00:00"}, "last_modified": "2025-07-31T10:00:05.407000+00:00", "last_update": "2026-02-12T20:39:38.929000+00:00", "license": "cc-by", "license_title": "Creative Commons Attribution 4.0 - CC BY 4.0", "metrics": {"dataservices": 0, "discussions": 0, "discussions_open": 0, "followers": 0, "followers_by_months": {"2025-06": 0, "2025-07": 0, "2025-08": 0, "2025-09": 0, "2025-10": 0, "2025-11": 0, "2025-12": 0, "2026-01": 0, "2026-02": 0, "2026-03": 0, "2026-04": 0, "2026-05": 0, "2026-06": 0}, "resources_downloads": 36, "reuses": 0, "reuses_by_months": {"2025-06": 0, "2025-07": 0, "2025-08": 0, "2025-09": 0, "2025-10": 0, "2025-11": 0, "2025-12": 0, "2026-01": 0, "2026-02": 0, "2026-03": 0, "2026-04": 0, "2026-05": 0, "2026-06": 0}, "views": 1426}, "organization": {"acronym": "AML", "badges": [], "class": "Organization", "id": "60a78a9245