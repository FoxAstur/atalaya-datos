], "schema": null, "slug": "cobertura-da-rede-movel-de-comunicacoes-eletronicas", "spatial": {"geom": null, "granularity": "country", "zones": ["country:pt"]}, "tags": ["rede-movel", "telecom"], "temporal_coverage": null, "title": "Cobertura da Rede M\u00f3vel de Comunica\u00e7\u00f5es Eletr\u00f3nicas", "uri": "https://dados.gov.pt/api/1/datasets/cobertura-da-rede-movel-de-comunicacoes-eletronicas/"}, {"access_audiences": [], "access_type": "open", "access_type_reason": null, "access_type_reason_category": null, "acronym": "MeteoAT", "archived": null, "authorization_request_url": null, "badges": [], "contact_points": [], "created_at": "2023-03-17T14:32:33.128000+00:00", "deleted": null, "description": "As esta\u00e7\u00f5es meteorol\u00f3gicas s\u00e3o equipamentos que s\u00e3o usados para medir e registar as condi\u00e7\u00f5es meteorol\u00f3gicas, tais como a temperatura, a humidade, a precipita\u00e7\u00e3o, a press\u00e3o atmosf\u00e9rica, a velocidade e dire\u00e7\u00e3o do vento, entre outros par\u00e2metros. Estas esta\u00e7\u00f5es t\u00eam como fun\u00e7\u00e3o recolher dados meteorol\u00f3gicos em tempo real, de forma a fornecer informa\u00e7\u00f5es precisas sobre as condi\u00e7\u00f5es clim\u00e1ticas numa determinada regi\u00e3o.\n\nAs esta\u00e7\u00f5es meteorol\u00f3gicas s\u00e3o compostas por diversos equipamentos, tais como term\u00f3metros, bar\u00f3metros, anem\u00f3metros, pluvi\u00f3metros, entre outros. Estes equipamentos permitem medir as diferentes vari\u00e1veis meteorol\u00f3gicas, que s\u00e3o ent\u00e3o registadas e analisadas. As esta\u00e7\u00f5es meteorol\u00f3gicas tamb\u00e9m podem incluir sensores e c\u00e2maras de v\u00eddeo para monitorizar e gravar a evolu\u00e7\u00e3o do tempo.\n\nAs informa\u00e7\u00f5es recolhidas pelas esta\u00e7\u00f5es meteorol\u00f3gicas s\u00e3o usadas para fornecer previs\u00f5es meteorol\u00f3gicas precisas e atualizadas, que s\u00e3o importantes para v\u00e1rias atividades, como a agricultura, a navega\u00e7\u00e3o, a avia\u00e7\u00e3o, o turismo, entre outras. As esta\u00e7\u00f5es meteorol\u00f3gicas tamb\u00e9m s\u00e3o usadas em investiga\u00e7\u00e3o cient\u00edfica e em estudos clim\u00e1ticos, contribuindo para um melhor entendimento do clima e das suas altera\u00e7\u00f5es.", "description_short": null, "extras": {}, "featured": false, "frequency": "punctual", "frequency_date": null, "harvest": null, "id": "64147a01078190c5c1b16232", "internal": {"created_at_internal": "2023-03-17T14:32:33.128000+00:00", "last_modified_internal": "2023-03-17T14:34:10.179000+00:00"}, "last_modified": "2023-03-17T14:34:10.179000+00:00", "last_update": "2023-03-17T14:32:40.808000+00:00", "license": "cc-by", "license_title": "Creative Commons Attribution 4.0 - CC BY 4.0", "metrics": {"dataservices": 0, "discussions": 0, "discussions_open": 0, "followers": 0, "followers_by_months": {"2025-06": 0, "2025-07": 0, "2025-08": 0, "2025-09": 0, "2025-10": 0, "2025-11": 0, "2025-12": 0, "2026-01": 0, "2026-02": 0, "2026-03": 0, "2026-04": 0, "2026-05": 0, "2026-06": 0}, "resources_downloads": 17, "reuses": 0, "reuses_by_months": {"2025-06": 0, "2025-07": 0, "2025-08": 0, "2025-09": 0, "2025-10": 0, "2025-11": 0, "2025-12": 0, "2026-01": 0, "2026-02": 0, "2026-03": 0, "2026-04": 0, "2026-05": 0, "2026-06": 0}, "views": 337}, "organization": {"acronym": "CIMAT", "badges": [{"kind": "public-service"}, {"kind": "certified"}], "class": "Organization", "id": "5e5d2009454ae38668d872c6", "logo": "https://dados.gov.pt/s/avatars/13/6af0efa412456699fd736e8afab121-original.png", "logo_thumbnail": "https://dados.gov.pt/s/avatars/13/6af0efa412456699fd736e8afab121-100.png", "name": "Comunidade Intermunicipal do Alto T\u00e2mega e Barroso", "page": "https://dados.gov.pt/organizations/comunidade-intermunicipal-do-alto-tamega-e-barroso", "permissions": {"delete": false, "edit": false, "harvest": false, "members": false, "private": false}, "slug": "comunidade-intermunicipal-do-alto-tamega-e-barroso", "