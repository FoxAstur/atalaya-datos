    <style>
        :root {
            --background-light-gray: #f5f6f7;
            --white: #fff;
            --primary-500: #154481;
            --primary-700: #072142;
            --secondary-500: #CD0E2D;
            --text-gray: #676767;
            --border-radius: 0.375rem;
            --box-shadow: 0rem 0rem 0.375rem rgba(0, 0, 0, 0.16);
        }
        body {
            font-family: Arial, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            background-color: var(--background-light-gray);
            margin: 0;
            text-align: center;
            padding: 1rem;
        }
        .container {
            background: var(--white);
            padding: 2.5rem;
            border-radius: var(--border-radius);
            box-shadow: var(--box-shadow);
            max-width: 25rem;
            width: 100%;
        }
        img {
            max-width: 17rem;
            margin-bottom: 1rem;
        }
        h1 {
            color: var(--secondary-500);
        }
        p {
            color: var(--text-gray);
        }
        .btn {
            display: inline-block;
            margin: 0.625rem 0.3125rem;
            padding: 0.625rem 1.25rem;
            background-color: var(--primary-500);
            color: var(--white);
            text-decoration: none;
            border-radius: var(--border-radius);
        }
        .btn:hover {
            background-color: var(--primary-700);
        }
        .mt-0{
            margin-top:0px;
        }
        .mb-0{
            margin-bottom:0px;
        }
        
        /* Media Queries */
        @media (max-width: 480px) {
            .container {
                padding: 2rem;
            }
            img {
                max-width: 14rem;
            }
            h1 {
                font-size: 1.5rem;
            }
            p {
                font-size: 0.875rem;
            }
        }
    </style>
</head>
