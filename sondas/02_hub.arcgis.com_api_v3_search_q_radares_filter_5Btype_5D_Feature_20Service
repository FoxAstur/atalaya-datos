tyle":"esriSLSNull","type":"esriSLS"},"color":[255,101,40,255],"style":"esriSFSSolid","type":"esriSFS"},"label":"6000","value":"6000"},{"symbol":{"outline":{"color":[110,110,110,255],"width":0,"style":"esriSLSNull","type":"esriSLS"},"color":[215,13,24,255],"style":"esriSFSSolid","type":"esriSFS"},"label":"10000","value":"10000"},{"symbol":{"outline":{"color":[110,110,110,255],"width":0,"style":"esriSLSNull","type":"esriSLS"},"color":[157,61,34,255],"style":"esriSFSSolid","type":"esriSFS"},"label":"20000","value":"20000"}],"type":"uniqueValue","fieldDelimiter":","},"scaleSymbols":true,"transparency":0,"labelingInfo":null},"copyrightText":"","supportsColumnStoreIndex":true,"supportsLayerOverrides":true,"geometryType":"esriGeometryPolygon"}],"licenseInfo":"","maxRecordCount":2000,"metadata":{"metadata":{"Esri":{"ArcGISFormat":1,"CreaTime":16591800,"CreaDate":20260302,"SyncOnce":"TRUE"},"@_xml:lang":"en","dataIdInfo":{"idAbs":"<b>Overview</b>  \n<p>This feature service provides spatial data on US radar coverage by the National Weather Service (NWS) and Nielsen Designated Market Area (DMA) boundaries. It integrates multiple layers encompassing radar coverage quality, media market demographics, and population statistics.</p>  \n\n<b>Feature Layers</b>  \n<ul>  \n<li><b>National Nexrad Coverage</b>: Represents the radar coverage areas at various heights across the United States with spatial geometry delineating coverage zones. It serves as a national overview of radar reach and effectiveness at elevation levels.</li>  \n<li><b>Nexrad Poor Coverage (above 4k ft)</b>: Highlights areas with poor radar coverage at altitudes above 4,000 feet, identifying geographic regions where radar signal strength and quality may be insufficient for comprehensive weather monitoring.</li>  \n<li><b>Poor Coverage by TV Market</b>: Combines radar coverage deficiencies with Nielsen DMA boundaries to assess poor radar performance in defined media market areas, enriched with demographic data such as population estimates and age distributions.</li>  \n<li><b>Nielsen DMA Boundaries</b>: Provides detailed boundaries for Nielsen Designated Market Areas, including demographic profiles like age, gender, and racial/ethnic composition. This layer supports contextual analysis of regions affected by radar coverage issues.</li>  \n</ul>  \n\n<b>Geographic Coverage</b>  \n<p>The layers collectively cover the continental United States, detailing national radar coverage and media market boundaries, allowing for integrated analysis across geographic and demographic dimensions.</p>  \n\n<b>Use Cases</b>  \n<ul>  \n<li>Assessing and planning for radar infrastructure improvements by identifying areas of poor coverage by altitude and media market.</li>  \n<li>Supporting broadcast and emergency management decision-making by linking radar performance with media market demographics.</li>  \n<li>Enabling demographic analysis within media markets to tailor communication strategies for weather-related events.</li>  \n</ul>","idPurp":"This feature service delivers detailed US radar coverage data alongside Nielsen DMA boundaries, combining weather radar performance with demographic insights for enhanced analysis of media markets and radar infrastructure.","searchKeys":{"keyword":["radar coverage","Nexrad","NWS","Nielsen DMA","media markets","population demographics","US weather monitoring","radar signal quality","broadcast regions"]}}},"?xml":{"@_standalone":"no","@_encoding":"UTF-8","@_version":"1.0"}},"modified":1772495653000,"modifiedProvenance":"item.modified","name":"US Nexrad Radar Coverage","openData":false,"orgId":"LT1iWT50Endhh6TU","orgName":"Baron Weather","organization":"Baron Weather","orgExtent":{"ymin":2699999.999999951,"xmin":-14999999.999999745,"ymax":6499999.99999985,"xmax":-6199999.999999896,"spatialReference":{"wkid":102100}},"orgContactEmail":"https://baronweather.com/support","owner":"jeffhuffman","region":"US","searchDescription":"Overview  \nThis feature service provides spatial data on US radar coverage by the National Weather Service (NWS) and Nielsen Designated Market Area (DMA) boundaries. It integrates multiple layers encompassing radar coverage quality, media market demographics, and population statistics.  \n\nFeature Layers  \n  \nNational Nexrad Coverage: Represents the radar coverage areas at various heights across the United States with spatial geometry delineating coverage zones. It serves as a national overview of radar reach and effectiveness at elevation levels.  \nNexrad Poor Coverage (above 4k ft): Highlights areas with poor radar coverage at altitudes above 4,000 feet, identifying geographic regions where radar signal strength and quality may be insufficient for comprehensive weather monitoring.  \nPoor Coverage by TV Market: Combines radar coverage deficiencies with Nielsen DMA boundaries to assess poor radar performance in defined media market areas, enriched with demographic data such as population estimates and age distributions.  \nNielsen DMA Boundaries: Provides detailed boundaries for Nielsen Designated Market Areas, including demographic profiles like age, gender, and racial/ethnic composition. This layer supports contextual analysis of regions affected by radar coverage issues.  \n  \n\nGeographic Coverage  \nThe layers collectively cover the continental United States, detailing national radar coverage and media market boundaries, allowing for integrated analysis across geographic and demographic dimensions.  \n\nUse Cases  \n  \nAssessing and planning for radar infrastructure improvements by identifying areas of poor coverage by altitude and media market.  \nSupporting broadcast and emergency management decision-making by linking radar performance with media market demographics.  \nEnabling demographic analysis within media markets to tailor communication strategies for weather-related events.  \n","server":{"supportedContingentValuesFormats":"JSON, PBF","supportsApplyEditsWithGlobalIds":false,