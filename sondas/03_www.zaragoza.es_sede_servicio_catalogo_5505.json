                        <!-- JS: Tabs + visor embebido -->
                        <script type="text/javascript">
                        /*<![CDATA[*/
                        (function() {
                            var visorModes = { 'tab-explorar': 'table', 'tab-mapa': 'map', 'tab-graficas': 'chart', 'tab-dashboard': 'dashboard' };
                            var visorContainers = { 'tab-explorar': 'visor-container-explorar', 'tab-mapa': 'visor-container-mapa', 'tab-graficas': 'visor-container-graficas', 'tab-dashboard': 'visor-container-dashboard' };
                            var visorIframes = {};

                            function buildVisorUrl(mode) {
                                var url = '/cont/vistas/servicio/visor-interactivo/visor/#/dataset/';
                                var p = ['embedded=true'];
                                if (typeof visorId !== 'undefined' && visorId != null) p.push('id=' + visorId);
                                if (typeof visorPrefixId !== 'undefined' && visorPrefixId != null) p.push('prefixId=' + visorPrefixId);
                                if (typeof visorVisAtt !== 'undefined' && visorVisAtt != null) p.push('visualizationDatasetAtt=' + visorVisAtt);
                                p.push('mode=' + mode);
                                if (typeof visorUserId !== 'undefined' && visorUserId != null) p.push('userId=' + visorUserId);
                                if (typeof visorEdition !== 'undefined') p.push('datasetEdition=' + visorEdition);
                                return url + '?' + p.join('&');
                            }

                            function createVisorIframe(mode) {
                                var iframe = document.createElement('iframe');
                                iframe.setAttribute('title', 'Visor de datos');
                                iframe.setAttribute('frameBorder', '0');
                                iframe.style.width = '100%';
                                iframe.style.border = 'none';
                                iframe.style.borderRadius = '8px';
                                iframe.style.height = '85vh';
                                iframe.addEventListener('load', function() {
                                    try {
                                        var rect = iframe.getBoundingClientRect();
                                        iframe.style.height = Math.max(1200, window.innerHeight - rect.top - 10) + 'px';
                                    } catch(e) {}
                                });
                                iframe.setAttribute('src', buildVisorUrl(mode));
                                return iframe;
                            }

                            function activateTab(tabId) {
                                document.querySelectorAll('.ficha-tab').forEach(function(t) { t.classList.remove('active'); });
                                document.querySelectorAll('.tab-panel').forEach(function(p) { p.classList.remove('active'); });
                                var btn = document.querySelector('[data-tab="' + tabId + '"]');
                                if (btn) btn.classList.add('active');
                                var panel = document.getElementById(tabId);
                                if (panel) panel.classList.add('active');

                                var tabs = document.querySelector('.ficha-tabs');
                                if (tabs) tabs.scrollIntoView({behavior: 'smooth', block: 'start'});

                                var mode = visorModes[tabId];
                                if (mode) {
                                    if (!visorIframes[tabId]) {
                                        var container = document.getElementById(visorContainers[tabId]);
                                        if (container) {
                                            var iframe = createVisorIframe(mode);
                                            container.appendChild(iframe);
                                            visorIframes[tabId] = iframe;
                                        }
                                    }
                                    document.querySelector('footer').style.display = 'none';
                                } else {
                                    document.querySelector('footer').style.display = '';
                                }
                            }

                            document.querySelectorAll('.ficha-tab').forEach(function(btn) {
                                btn.addEventListener('click', function() {
                                    activateTab(this.getAttribute('data-tab'));
                                });
                            });
                        })();
                        /*]]>*/
                        </script>

