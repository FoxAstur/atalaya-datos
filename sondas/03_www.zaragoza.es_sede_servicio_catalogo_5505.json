                    <button class="scroll-top-btn" id="scrollTopBtn" title="Volver arriba" onclick="window.scrollTo({top:0,behavior:'smooth'})">
                        <span class="fa fa-chevron-up"></span>
                    </button>
                    <script type="text/javascript">
                    /*<![CDATA[*/
                    (function(){
                        var topBtn = document.getElementById('scrollTopBtn');
                        var bottomBtn = document.getElementById('scrollBottomBtn');
                        window.addEventListener('scroll', function(){
                            var atBottom = (window.innerHeight + window.scrollY) >= document.body.scrollHeight - 50;
                            topBtn.style.display = window.scrollY > 300 ? 'block' : 'none';
                            bottomBtn.style.display = !atBottom && document.body.scrollHeight > window.innerHeight * 1.5 ? 'block' : 'none';
                        });
                        window.dispatchEvent(new Event('scroll'));
                    })();
                    /*]]>*/
                    </script>

