	<script type="module">
		/*<![CDATA[*/
		import { cargarDesdeLocalStorage, guardarEnLocalStorage, checkValidLocalStorage } from "/cont/vistas/fragmentos/js/localstorage.js"
			const $togglemenu = $("#togglemenu")
				// Manejadores de eventos
				function toggleOpen(e) {
				    
				    const $icon = $("#togglemenu>span")
				    const isOpenInPrevState = $togglemenu.attr('aria-expanded')
				    if(isOpenInPrevState && isOpenInPrevState === 'true'){
				    	$togglemenu.attr('aria-label', 'Abrir Mapa Web')
				    	$togglemenu.attr('title', 'Abrir Mapa Web')
				    } else {
				    	$togglemenu.attr('aria-label', 'Cerrar Mapa Web')
				    	$togglemenu.attr('title', 'Cerrar Mapa Web')
				    }
				    $icon.toggleClass('fa-bars fa-xmark')
				}
		
				function showAvisoGeneral() {
				    $('.aviso-general').removeClass('hidden');
				}
		
				function hideAvisoGeneral() {
				    $('.aviso-general').remove();
				    setTimeout(() => updatePaddingTop(), 200);
				}
		
				function cerrarAvisoGeneral() {
				    $('.aviso-general').remove();
				    const data = cargarDesdeLocalStorage("avisogeneralZGZ");
				    data.show = false;
				    guardarEnLocalStorage("avisogeneralZGZ", data);
				    hideAvisoGeneral();
				}
		
				function updateLastUpdate() {
				    const newLastUpdate = $('.aviso-general .enlaceAviso').data('date');
				    if (!checkValidLocalStorage("avisogeneralZGZ", "LastUpdate") && !newLastUpdate) return;
				    const persistedLastUpdate = cargarDesdeLocalStorage("avisogeneralZGZ");
				    if (newLastUpdate !== persistedLastUpdate.LastUpdate) {
				        persistedLastUpdate.LastUpdate = newLastUpdate;
				        persistedLastUpdate.show = true;
				        showAvisoGeneral();
				        guardarEnLocalStorage("avisogeneralZGZ", persistedLastUpdate);
				    }
				}
		
				function initializeLocalStorage() {
				    if (!cargarDesdeLocalStorage("avisogeneralZGZ")) {
				    		const newLastUpdate = $('.aviso-general .enlaceAviso').data('date') || new Date();
				    		const data = { show: true, LastUpdate: newLastUpdate };
				        guardarEnLocalStorage("avisogeneralZGZ", data);
				    } else {
				        const data = cargarDesdeLocalStorage("avisogeneralZGZ");
				        if (data.show) {
				            showAvisoGeneral();
				        }
				    }
				}

				function handleTabIndex(action){
						if(action === true) {
							$('#cabecera').attr('tabindex', 0)
							$('#cabecera').focus()
						} else {
							$('#cabecera').removeAttr('tabindex')
						}
					 
				}

				function handleKeyboard(e){
					const mapawebisopen= $("#cabecera").attr("aria-expanded") === 'true'
					 if (e.keyCode == '9') {
			         setTimeout(() => {
			            const activeElement = $(document).attr('activeElement')
			            if ($(activeElement).parents("#cabecera").length < 1 && mapawebisopen) {
			               if (!$(activeElement).is("#togglemenu")) {
			                  $togglemenu.click()
			                  handleTabIndex(false)
			               }
			            }
			         }, 200)

			      }

			      if (e.keyCode == '27' && mapawebisopen) {
			         $togglemenu.click()
			         handleTabIndex(false)
			      }
			      if (e.keyCode == '77' && e.ctrlKey) {
			         $togglemenu.click()
			         if(!mapawebisopen) {
			         	handleTabIndex(true)
			         } else {
			         	handleTabIndex(false)
			         }
			         
			      }


				}
		
				documentReady(() => {
					$togglemenu.on('click', toggleOpen);
					$("#cerrarAvisoGeneral").on('click', cerrarAvisoGeneral);
					$(document).on('keyup', handleKeyboard)

					initializeLocalStorage();
					updateLastUpdate();
				});

				
		/*]]>*/
		
	</script>

    
