tViewed":1793422800000},{"id":"f44f6788b99a4d6f8e84364beeabf77d","owner":"HunterWater_GIS","created":1594676497000,"modified":1738110386000,"guid":null,"name":"Australia_Rain_Radar_View","title":"Australia Rain Radar View","type":"Feature Service","typeKeywords":["ArcGIS Server","Data","Feature Access","Feature Service","Service","Singlelayer","Hosted Service","View Service"],"description":null,"tags":["Rain Radar","Hunter Water"],"snippet":"This Australian radar mosaic service depicts contoured reflectivity at the lowest altitude as observed by the radar.  These mosaics have been quality controlled to remove non-weather artifacts from the data. The quality control procedures make the end product much easier for end users to identify precipitation and potentially hazardous weather. Radar reflectivity indicates the strength of the electromagnetic wave reflected back to the radar off of a hydrometeor (rain drop, snow flake, etc).  The higher the reflectivity, the more intense the precipitation is.  These mosaics are updated every 6 minutes and contain the latest radar mosaic for Australia. \n\nDTN WeatherOps complete GIS offering is available via ESRI Map Services served from our ArcGIS Server infrastructure hosted on Amazon Web Services.\n\nFor the bushfires of 2019/2020, DTN have provided their rainfall and wind feeds.  This feed is short-term and will be made private at some point nearer mid Feb.","thumbnail":"thumbnail/ago_downloaded.png","documentation":null,"extent":[[-180,-90],[180,90]],"categories":[],"spatialReference":"4326","accessInformation":null,"classification":null,"licenseInfo":null,"culture":"en-au","properties":null,"advancedSettings":null,"url":"https://services7.arcgis.com/9nlQUywsHzFwAwIM/arcgis/rest/services/Australia_Rain_Radar_View/FeatureServer","proxyFilter":null,"access":"public","size":-1,"subInfo":0,"appCategories":[],"industries":[],"languages":[],"largeThumbnail":null,"banner":null,"screenshots":[],"listed":false,"numComments":0,"numRat