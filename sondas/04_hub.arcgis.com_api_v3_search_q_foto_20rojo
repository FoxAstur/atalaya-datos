94,40.341752066456294],[-3.7933050239539994,40.49409087548539]]],"spatialReference":{"wkid":4326}},"setBy":null},"snippet":null,"culture":"es-es"},"links":{"self":"https://hub.arcgis.com/api/v3/datasets/49ca676b57ae4ab28672f417c121339a_0","rawEs":"https://hub.arcgis.com/api/es/datasets/49ca676b57ae4ab28672f417c121339a_0","itemPage":"https://www.arcgis.com/home/item.html?id=49ca676b57ae4ab28672f417c121339a","esriRest":"https://www.arcgis.com/sharing/content/items/49ca676b57ae4ab28672f417c121339a?f=json"},"meta":{"highlights":{"name":["<mark class=\"hub-search-highlight name-highlight\">foto rojo</mark>"]},"matchedFields":["name","stemmedName"]}},{"id":"41ee3c691359437aa9df2a09d7f6124e","type":"dataset","attributes":{"errors":[],"access":"public","additionalResources":[],"collection":["App"],"categories":[],"commentsEnabled":true,"composeStatus":{"lastSuccessAt":1736950320879,"retries":0,"pass":true,"lastRetriedAt":1736950320880},"composedAt":1736950320879,"content":"Dashboard","created":1698159012000,"description":"<span><p style='text-align:justify; margin-top:0pt; margin-bottom:0pt;'><span style='font-size:11pt; font-family:Arial, sans-serif; color:rgb(0, 0, 0); background-color:transparent; font-variant-numeric:normal; font-variant-east-asian:normal; font-variant-alternates:normal; font-variant-position:normal;'>Botón Rojo es una herramienta que permite identificar aquellos territorios que tendrían un mayor potencial de ignición y propagación de incendios forestales, lo que se traduce en un escenario complejo para el control, sobre todo existiendo simultaneidad de incidentes.</span></p><p style='text-align:justify; margin-top:0pt; margin-bottom:0pt;'><br /></p><p style='text-align:justify; margin-top:0pt; margin-bottom:0pt;'><span style='font-size:11pt; font-family:Arial, sans-serif; color:rgb(0, 0, 0); background-color:transparent; font-variant-numeric:normal; font-variant-east-asian:normal; font-variant-alternates:normal; font-variant-position:normal;'>Fue creada por el Departamento de Desarrollo e Investigación de la Gerencia de Protección contra Incendios Forestales de CONAF el año 2018, y su versión más reciente lanzada el 2023, utiliza las últimas tecnologías para su generación, análisis y publicación, entre ellas, Google Earth Engine y ArcGIS Online.</span></p><p style='text-align:justify; margin-top:0pt; margin-bottom:0pt;'><br /></p><p style='text-align:justify; margin-top:0pt; margin-bottom:0pt;'><span style='font-size:11pt; font-family:Arial, sans-serif; color:rgb(0, 0, 0); background-color:transparent; font-variant-numeric:normal; font-variant-east-asian:normal; font-variant-alternates:normal; font-variant-position:normal;'>Su principal objetivo es apoyar los procesos de planificación ante escenarios complejos por condiciones propicias para el inicio y desarrollo de incendios forestales y orientar acciones de prevención, a partir de los territorios críticos detectados por la herramienta.</span></p><p style='text-align:justify; margin-top:0pt; margin-bottom:0pt;'><br /></p><p style='text-align:justify; margin-top:0pt; margin-bottom:0pt;'><span style='font-size:11pt; font-family:Arial, sans-serif; color:rgb(0, 0, 0); background-color:transparent; font-variant-numeric:normal; font-variant-east-asian:normal; font-variant-alternates:normal; font-variant-position:normal;'>La condición de Botón Rojo es asignada a todos aquellos territorios en donde se cumplen simultáneamente las siguientes condiciones, calculadas a partir del último pronóstico meteorológico GFS de NOAA, para el rango horario entre las 14:00 y 18:00 horas:</span></p><ul><li><p style='text-align:justify; margin-top:0pt; margin-bottom:0pt;'><span style='font-size:11pt; background-color:transparent; font-variant-numeric:normal; font-variant-east-asian:normal; font-variant-alternates:normal; font-variant-position:normal; text-wrap:wrap;'>Probabilidad de ignición mayor o igual a 70%, y</span></p></li><li><p style='text-align:justify; margin-top:0pt; margin-bottom:0pt;'><span style='font-size:11pt; background-color:transparent; font-variant-numeric:normal; font-variant-east-asian:normal; font-variant-alternates:normal; font-variant-position:normal; text-wrap:wrap;'>Velocidad del viento mayor o igual a 20 km/h.</span></p></li></ul><p style='text-align:justify; margin-top:0pt; margin-bottom:0pt;'><br /></p><p style='text-align:justify; margin-top:0pt; margin-bottom:0pt;'><span style='font-size:11pt; font-family:Arial, sans-serif; color:rgb(0, 0, 0); background-color:transparent; font-variant-numeric:normal; font-variant-east-asian:normal; font-variant-alternates:normal; font-variant-position:normal;'>Botón Rojo utiliza la cobertura Landcover 2021 generada por el programa europeo Copernicus, a partir de la cual se realiza un filtro de la “superficie combustible”, empleando para los cálculos sólo aquellos terrenos correspondientes a bosques, matorrales, pastizales, cultivos agrícolas y humedales.</span></p></span>","downloadable":false,"enrichCoverage":"unknown","enrichQuality":85,"extent":null,"groupIds":[],"hasApi":false,"hubType":"Dashboard","id":"41ee3c691359437aa9df2a09d7f6124e","itemId":"41ee3c691359437aa9df2a09d7f6124e","itemModified":1732287539000,"itemExtent":[],"layer":null,"layers":null,"licenseInfo":"<div style='text-align:justify;'>Los elementos y la información desplegada en este elemento son propiedad de CONAF y elaborados por el Departamento de Desarrollo e Investigación de la Gerencia de Protección contra Incendios Forestales. Si bien los datos son de uso público, en su utilización deberá citarse a CONAF como fuente de estos.</div>","metadata":null,"modified":1732287539000,"modifiedProvenance":"item.modified","name":"Boton Rojo CONAF","openData":false,"orgId":"A1ELWse9bRAi2JiV","orgName":"geprif.conaf","organization":"geprif.conaf","orgExtent":{"ymin":2700000,"xmin":-15000000,"ymax":6500000,"xmax":-6200000,"spatialReference":{"wkid":102100}},"owner":"deigeprif","region":"CL","searchDescription":"Botón Rojo es una herramienta que permite identificar aquellos territorios que tendrían un mayor potencial de ignición y propagación de incendios forestales, lo que se traduce en un escenario complejo para el control, sobre todo existiendo simultaneidad de incidentes.Fue creada por el Departamento de Desarrollo e Investigación de la Gerencia de Protección contra Incendios Forestales de CONAF el año 2018, y su versión más reciente lanzada el 2023, utiliza las últimas tecnologías para su generación, análisis y publicación, entre ellas, Google Earth Engine y ArcGIS Online.Su principal objetivo es apoyar los procesos de planificación ante escenarios complejos por condiciones propicias para el inicio y desarrollo de incendios forestales y orientar acciones de prevención, a partir de los territorios críticos detectados por la herramienta.La condición de Botón Rojo es asignada a todos aquellos territorios en donde se cumplen simultáneamente las siguientes condiciones, calculadas a partir del último pronóstico meteorológico GFS de NOAA, para el rango horario entre las 14:00 y 18:00 horas: Probabilidad de ignición mayor o igual a 70%, y Velocidad del viento mayor o igual a 20 km/h.Botón Rojo utiliza la cobertura Landcover 2021 generada por el programa europeo Copernicus, a partir de la cual se realiza un filtro de la “superficie combustible”, empleando para los cálculos sólo aquellos terrenos correspondientes a bosques, matorrales, pastizales, cultivos agrícolas y humedales.","server":null,"size":79974,"slug":"geprif::boton-rojo-conaf","source":"geprif.conaf","sourceProvenance":"org.name","structuredLicense":{"text":"Los elementos y la información desplegada en este elemento son propiedad de CONAF y elaborados por el Departamento de Desarrollo e Investigación de la Gerencia de Protección contra Incendios Forestales. Si bien los datos son de uso público, en su utilización deberá citarse a CONAF como fuente de estos.","type":"custom"},"license":"custom","tags":["conaf","deigeprif","incedios forestales","boton rojo"],"thumbnail":"thumbnail/thumbnail1704230731166.png","thumbnailUrl":"thumbnail/thumbnail1704230731166.png","type":"Dashboard","typeCategories":["App"],"typeKeywords":["ArcGIS Dashboards","Dashboard","Mobile","Operations Dashboard"],"validExtent":true,"boundary":null,"snippet":"Cuadro de mando con información relativa a condición de Botón Rojo pronosticada a 5 días.","culture":"es-es"},"links":{"self":"https://hub.arcgis.com/api/v3/datasets/41ee3c691359437aa9df2a09d7f6124e","rawEs":"https://hub.arcgis.com/api/es/datasets/41ee3c691359437aa9df2a09d7f6124e","itemPage":"https://www.arcgis.com/home/item.html?id=41ee3c691359437aa9df2a09d7f6124e","esriRest":"https://www.arcgis.com/sharing/content/items/41ee3c691359437aa9df2a09d7f6124e?f=json"},"meta":{"highlights":{"name":["Boton <mark class=\"hub-search-highlight name-highlight\">Rojo</mark> CONAF"],"tags":["boton <mark class=\"hub-search-highlight tags-highlight\">rojo</mark>"],"searchDescription":["Botón <mark class=\"hub-search-highlight searchDescription-highlight\">Rojo</mark> es una herramienta que permite identificar aquellos territorios que tendrían un mayor potencial de ignición y propagación de incendios forestales, lo que se traduce en un escenario complejo para el control, sobre todo existiendo simultaneidad de incidentes.Fue creada por el Departamento de Desarrollo e Investigación de la Gerencia de Protección contra Incendios Forestales de CONAF el año 2018, y su versión más reciente lanzada el 2023, utiliza las últimas tecnologías para su generación, análisis y publicación, entre ellas, Google Earth Engine y ArcGIS Online.Su principal objetivo es apoyar los procesos de planificación ante escenarios complejos por condiciones propicias para el inicio y desarrollo de incendios forestales y orientar acciones de prevención, a partir de los territorios críticos detectados por la herramienta.La condición de Botón Rojo es asignada a todos aquellos territorios en donde se cumplen simultáneam