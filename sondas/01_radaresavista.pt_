    </div>
</section>


<section id="radares" style="background: #9bc8e2; margin: 0; padding: 45px 16px;"> 
    <div class="container">
        <div class="row">
                                        <div class="col-lg-6 col-md-6 col-sm-12 radar-item mb-4">
                    <h2 >Veja no vídeo como funcionam os Radares de Velocidade Instantânea</h2>
                    
<object data="https://www.youtube.com/embed/lRal4u2rsKA" style="width:100%; outline: none; border:0; margin:0; padding: 0;" height="300px" width="100%" allowfullscreen></object>
</iframe>
