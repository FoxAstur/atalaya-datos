<div class="hide">
    <i id="long" data-value="-7.8536599"></i>
    <i id="lat" data-value="39.557191"></i>
    <i id="zoom" data-value="7.2"></i>
    <i id="vi" data-value="https://radaresavista.pt/wp-content/uploads/2021/11/icones-finais.png"></i>
    <i id="vi2" data-value="https://radaresavista.pt/wp-content/uploads/2021/11/icon-vi-fase2.png"></i>
    <i id="vm" data-value="https://radaresavista.pt/wp-content/uploads/2021/11/icon-vm-fase2.png"></i>
    <i id="road" data-value="false"></i>
    <i id="company" data-value="false"></i>
</div>
<div id="mapa-radares" style="width: 100%; height: 550px;"></div>
<script>
$(document).ready(function () {

    var lat = $('#lat'),
        long = $('#long'),
        zoom = $('#zoom'),
        road = $('#road'),
        company = $('#company');

    var mymap = L.map('mapa-radares', {
        dragging: !L.Browser.mobile,
        tap: !L.Browser.mobile
    }).setView([lat.attr('data-value'), long.attr('data-value')], zoom.attr('data-value'));

    function makeIcon(url) {
        return L.icon({
            iconUrl: url,
            iconSize: [38, 49],
            shadowSize: [50, 64],
            iconAnchor: [24, 38],
            shadowAnchor: [4, 62],
            popupAnchor: [-3, -40]
        });
    }

    var vi  = makeIcon($('#vi').attr('data-value'));
    var vi2 = makeIcon($('#vi2').attr('data-value'));
    var vm  = makeIcon($('#vm').attr('data-value'));

    function replaceAll(string, search, replace) {
        return string.split(search).join(replace);
    }

    // Mapa base sem chave: Esri World Light Gray
    L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Base/MapServer/tile/{z}/{y}/{x}', {
        attribution: 'Tiles &copy; Esri &mdash; Esri, DeLorme, NAVTEQ',
        maxZoom: 16
    }).addTo(mymap);

    $.getJSON("/wp-content/themes/ansr-radares/dataTest.json", function (data) {
        if (road.attr('data-value') != "false" && road.attr('data-value') != "Estradas") {
            data = data.filter(function (item) {
                return item.Estrada == road.attr('data-value');
            });
        }
        if (company.attr('data-value') != "false") {
            data = data.filter(function (item) {
                return item.EGV == company.attr('data-value');
            });
        }

        $.each(data, function (i, val) {
            var axis = replaceAll((val['Coordenada']).trim(), 'Â', '');
            var res = axis.split(/[,;]/);
            var x = (res[0]).replace(/[^0-9\.]+/g, "");
            var y = "-" + (res[1]).replace(/[^0-9\.]+/g, "");

            var isVm = (val['Tipo']).toLowerCase() == "vm";
            var marker = isVm ? vm : vi;

            var hasSentido = (val['Sentido'] != '' && val['Sentido'] != null);

            var text = "<b style='font-size:14px;'>" + val['Freguesia'] + "</b>" +
                "<hr style='margin: 2px 0 8px'> " + val['Estrada'] +
                "<br>Km: " + String(val['Km Inicial']).replace(".", ",") +
                (hasSentido ? "<br>Sentido: " + val['Sentido'] : '') +
                " <br>Limite de velocidade: " + val['Velocidade'] + "Km/h <br>" + val['EGV'];

            if (isVm) {
                text = "<b style='font-size:14px;'>" + val['Freguesia'] + "</b>" +
                    "<hr style='margin: 2px 0 8px'> " + val['Estrada'] +
                    "<br>Km Inicial: " + String(val['Km Inicial']).replace(".", ",") +
                    "<br>KM Final: " + String(val['Km Final']).replace(".", ",") +
                    (hasSentido ? "</br>" + val['Sentido'] : "") +
                    " <br>Limite de velocidade: " + val['Velocidade'] + "Km/h <br> " + val['EGV'];
            }

            L.marker([x, y], { icon: marker }).addTo(mymap).bindPopup(text);
        });
    });
});
</script>

<section id="radares">
	<div class="container">
        <div class="row">
                                        <div class="col-lg-6 col-md-6 col-sm-12 radar-item">
                    <picture><source data-srcset="https://radaresavista.pt/wp-content/webp-express/webp-images/doc-root/wp-content/uploads/2023/01/icon-VI-1.png.webp" type="image/webp"><img decoding="async" data-src="https://radaresavista.pt/wp-content/uploads/2023/01/icon-VI-1.png" alt="Icon" class="webpexpress-processed lazyload" src="data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMSIgaGVpZ2h0PSIxIiB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciPjwvc3ZnPg==" style="--smush-placeholder-width: 807px; --smush-placeholder-aspect-ratio: 807/972;"></picture>
